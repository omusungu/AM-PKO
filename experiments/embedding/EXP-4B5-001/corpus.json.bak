    "project": "MUSUNGU TECH-FUNDI",
    "knowledge_type": "IDEA",
    "topic": "Interpass Temperature Control",
    "granularity": "Hypothesis",
    "title": "Use temperature crayons to limit cumulative heat",
    "content": "Use temperature-indicating crayons at tack and weld stages to keep interpass temperature below a chosen threshold. If successful on scrap, it may reduce cumulative distortion without slowing production excessively.",
